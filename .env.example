OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_GEO_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional security gates for dashboard/API.
DASHBOARD_PASSWORD=
DASHBOARD_API_KEY=

# Persistence backend: file | firestore
DATA_BACKEND=file
FIRESTORE_NAMESPACE=dv_agent
GOOGLE_APPLICATION_CREDENTIALS=
DEFAULT_ORG_ID=vancouver
ORG_DISPLAY_NAME=GEOrge
ORG_LOGO_URL=/assets/destination-vancouver-logo.png

# First admin bootstrap (created automatically if missing)
AUTH_BOOTSTRAP_EMAIL=admin@destinationvancouver.com
AUTH_BOOTSTRAP_PASSWORD=change-me
AUTH_BOOTSTRAP_NAME=GEOrge Admin
AUTH_SESSION_TTL_HOURS=72
AUTH_INVITE_TTL_HOURS=168
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Scheduled GEO job defaults
GEO_SCHEDULE_REPEATS=1
GEO_SCHEDULE_PROVIDERS=chatgpt,gemini
GEO_SCHEDULE_MARKETS=Los Angeles,Seattle,Mexico City,Sydney
GEO_SCHEDULE_ORG_ID=vancouver
