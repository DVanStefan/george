    "agents:list": "node src/cli.js agents:list",
    "agents:bootstrap": "node src/cli.js agents:bootstrap",
    "agents:add": "node src/cli.js agents:add",
    "agents:enable": "node src/cli.js agents:enable",
    "agents:disable": "node src/cli.js agents:disable",
    "agents:remove": "node src/cli.js agents:remove",
    "geo:migrate:firestore": "node src/migrate-geo-to-firestore.js",
    "geo:run:scheduled": "node src/geo-scheduled-run.js",
    "geo:run:watchdog": "node src/geo-schedule-watchdog.js",
    "deploy:hosting:dev": "firebase deploy --only hosting:dev --project dvan-agent-team",
    "deploy:hosting:prod": "firebase deploy --only hosting:prod --project dvan-agent-team",
